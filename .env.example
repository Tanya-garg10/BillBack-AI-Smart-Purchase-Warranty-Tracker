# OPENAI_API_KEY: Required for OpenAI API calls (invoice extraction).
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# OPENAI_MODEL_ID: Optional. Defaults to gpt-4o.
OPENAI_MODEL_ID="gpt-4o"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AWS Configuration (Amazon S3, Bedrock, DynamoDB, EventBridge)
# If credentials are not provided, BillBack AI runs in safe local-simulation mode using AWS SDK schemas
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_INVOICE_BUCKET="billback-invoices-prod"
AWS_DYNAMODB_TABLE="BillBack-Purchases"
AWS_BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20241022-v2:0"

